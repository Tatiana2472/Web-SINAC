# Soporte para rutas de React Router en Apache / InfinityFree / rf.gd
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # No redirigir si el archivo o directorio existe fisicamente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Enviar las demas rutas al index.html de React
  RewriteRule . /index.html [L]
</IfModule>

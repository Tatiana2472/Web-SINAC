# Soporte para rutas de React Router en Apache / InfinityFree
Options -MultiViews
RewriteEngine On

# Servir directamente archivos y carpetas existentes
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Enviar las demás rutas a la aplicación React
RewriteRule ^ index.html [L]
